# API Gateway Environment Variables
API_GATEWAY_PORT=3000
RABBITMQ_URL=amqp://localhost:5672
REDIS_URL=redis://localhost:6379
USER_SERVICE_URL=http://localhost:3001
TEMPLATE_SERVICE_URL=http://localhost:3004
JWT_SECRET=your-secret-key-change-in-production

# User Service Environment Variables
USER_SERVICE_PORT=3001
USER_DATABASE_URL=postgresql://user:password@localhost:5432/users
USER_REDIS_URL=redis://localhost:6379
JWT_EXPIRATION=24h
BCRYPT_ROUNDS=10

# Email Service Environment Variables
EMAIL_SERVICE_PORT=3002
EMAIL_RABBITMQ_URL=amqp://localhost:5672
EMAIL_REDIS_URL=redis://localhost:6379
EMAIL_TEMPLATE_SERVICE_URL=http://localhost:3004
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=5

# Push Service Environment Variables
PUSH_SERVICE_PORT=3003
PUSH_RABBITMQ_URL=amqp://localhost:5672
PUSH_REDIS_URL=redis://localhost:6379
PUSH_TEMPLATE_SERVICE_URL=http://localhost:3004
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-project-id
PUSH_MAX_RETRY_ATTEMPTS=3
PUSH_RETRY_BACKOFF_SECONDS=5

# Template Service Environment Variables
TEMPLATE_SERVICE_PORT=3004
TEMPLATE_DATABASE_URL=postgresql://user:password@localhost:5432/templates
TEMPLATE_REDIS_URL=redis://localhost:6379
DEFAULT_LANGUAGE=en

# Shared Infrastructure
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
POSTGRES_USER=user
POSTGRES_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379
